{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@1.4.0"]
    },
    "serena": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "serena start-mcp-server --context claude-code --project-from-cwd --enable-web-dashboard false"
      ],
      "env": {}
    }
  }
}
